# Laissez ces deux lignes vides pour tester en local sur un seul appareil.
# Renseignez-les pour activer le partage à deux, la synchro et les photos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Facultatif, uniquement pour exécuter scripts/lien-dev.js (voir le README).
# Jamais préfixé VITE_, jamais exposé au client.
SUPABASE_SERVICE_ROLE_KEY=

# Facultatif, pour les notifications push (voir le README). Clé publique
# uniquement — la clé privée va dans les secrets de l'Edge Function, jamais ici.
VITE_VAPID_PUBLIC_KEY=

# Facultatif, pour chercher un GIF à associer à l'humeur du jour (API Giphy,
# gratuite — dev.giphy.com). Sans elle, seul l'ajout d'une photo perso marche.
VITE_GIPHY_API_KEY=
